# Copie este arquivo para .env.local e preencha os valores.

# Segredo usado para assinar o login. Use um texto longo e aleatório (mínimo 32 caracteres).
# Gerar um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Primeiro usuário (criado automaticamente quando o banco está vazio).
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=
ADMIN_NAME=Seu Nome

# Banco de dados.
# Local: deixe como está (cria o arquivo local.db).
# Online (Turso): libsql://seu-banco.turso.io  +  DATABASE_AUTH_TOKEN
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Chave da API do Google Maps (Places API New). Vazio = modo demonstração.
GOOGLE_MAPS_API_KEY=

# Avisos por e-mail (opcional): resumo diário de retornos e alerta de erros. Conta grátis em resend.com.
RESEND_API_KEY=
ALERT_EMAIL=
# Endereço de remetente (padrão: onboarding@resend.dev, que só envia para o e-mail da sua conta Resend).
RESEND_FROM=
# Segredo da rota do resumo diário (a Vercel envia sozinha). Use um texto longo e aleatório.
CRON_SECRET=
# Endereço do sistema online, usado no link do e-mail (opcional).
APP_URL=
